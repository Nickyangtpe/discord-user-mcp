# Copy to .env (or export these in your shell) and fill in the token.
# The server reads .env from its working directory at startup; real environment
# variables always win. Set DISCORD_MCP_ENV_FILE=0 to disable the file.
#
# The token must be a Discord USER token. Bot tokens are rejected:
# the server never sends the "Bot " prefix and refuses a token that
# authenticates a bot account.

DISCORD_USER_TOKEN=

# Alternative: read the token from a file (kept out of the process list).
# DISCORD_USER_TOKEN_FILE=%LOCALAPPDATA%\discord-user-mcp\token
# If neither is set, <state dir>\token is used.

# Where the SQLite approval store, audit log and console token live.
# DISCORD_MCP_STATE_DIR=%LOCALAPPDATA%\discord-user-mcp

# --- approval gate ---------------------------------------------------------
# Seconds a pending request stays approvable (30-3600, default 300).
DISCORD_MCP_APPROVAL_TTL=300
# The console is the only way to approve. Keep it enabled.
DISCORD_MCP_CONSOLE_ENABLED=1
# Loopback only; a non-loopback host is rejected at startup.
DISCORD_MCP_CONSOLE_HOST=127.0.0.1
# 0 = pick a free port each run.
DISCORD_MCP_CONSOLE_PORT=0
# Write the console URL + token to <state>/approval-console.json (0600).
DISCORD_MCP_CONSOLE_TOKEN_FILE=1
# Only for tests: pin the console token instead of generating one.
# DISCORD_MCP_CONSOLE_TOKEN=

# --- safety ----------------------------------------------------------------
# 1 = every mutating tool is refused, reads still work.
DISCORD_MCP_READ_ONLY=0
# 1 = do not verify the token with GET /users/@me at startup.
DISCORD_MCP_SKIP_AUTH_CHECK=0
# 0 = do not write the JSONL audit log.
DISCORD_MCP_AUDIT=1

# --- HTTP ------------------------------------------------------------------
# Point at a stub server for tests.
# DISCORD_MCP_API_BASE=http://127.0.0.1:8080/api/v9
DISCORD_MCP_TIMEOUT=30
DISCORD_MCP_CONNECT_TIMEOUT=10
DISCORD_MCP_MAX_RETRIES=3
DISCORD_MCP_MAX_429_RETRIES=5

# --- tool response budgets --------------------------------------------------
# The model may choose response_max_bytes per call (UTF-8 JSON tool content).
# Default 4 MiB; operator ceiling 16 MiB. Both must be 1024..16777216 bytes.
# The default must not exceed the ceiling. No MCP tool can change this ceiling.
DISCORD_MCP_RESPONSE_DEFAULT_BYTES=4194304
DISCORD_MCP_RESPONSE_MAX_BYTES=16777216

# --- uploads ---------------------------------------------------------------
# os.pathsep separated allow-list. Default: <state>/uploads
# DISCORD_MCP_UPLOAD_ROOTS=C:\Users\you\Pictures
DISCORD_MCP_MAX_UPLOAD_BYTES=26214400
DISCORD_MCP_MAX_UPLOAD_FILES=10

DISCORD_MCP_LOG_LEVEL=INFO
